{
  "name": "dsh-remember",
  "version": "0.3.0",
  "description": "Cross-session long-term memory for the DeepSeek Harness: idle sessions are extracted and consolidated into a searchable file-based memory workspace, then recalled through prompt injection with citation tracking, a settings page, a sidebar status entry and a memory viewer.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "long-term-memory",
    "agent-memory"
  ],
  "author": "Arborsm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arborsm/dsh-remember.git"
  },
  "homepage": "https://github.com/Arborsm/dsh-remember#readme",
  "bugs": "https://github.com/Arborsm/dsh-remember/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-hooks.mjs --test tests/*.test.mjs",
    "shots": "node --import ./tests/register-hooks.mjs tools/shots.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.10.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "icon.svg"
}
