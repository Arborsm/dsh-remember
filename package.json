{
  "name": "dsh-remember",
  "version": "0.2.0",
  "description": "Cross-session long-term memory for the DeepSeek Harness: a two-phase extraction/consolidation pipeline over a file-based memory workspace, recall injection, a citation feedback loop, lease-based job semantics, plus a settings page, a sidebar status panel and a memory viewer.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "memory",
    "long-term-memory",
    "agent-memory"
  ],
  "author": "Arborsm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arborsm/dsh-remember.git"
  },
  "homepage": "https://github.com/Arborsm/dsh-remember#readme",
  "bugs": "https://github.com/Arborsm/dsh-remember/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "settingsScope"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-hooks.mjs --test tests/*.test.mjs",
    "shots": "node --import ./tests/register-hooks.mjs tools/shots.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.10.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
